<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Scheduled inbox-triage run: Monday to Friday at 10:00. StartCalendarInterval
  holds one entry per day; to change the schedule, edit Weekday (0 or 7 =
  Sunday, 1 = Monday), Hour and Minute, or add and remove entries.
  Fill the placeholders (absolute paths only) and install the result into
  ~/Library/LaunchAgents/; launchd reloads user jobs at login only from there.
  A run missed while the Mac sleeps starts once on wake, even on a later day;
  one missed while it is off is not made up.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__RUNNER__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>INBOX_TRIAGE_VAULT</key>
    <string>__VAULT__</string>
    <key>INBOX_TRIAGE_CLAUDE</key>
    <string>__CLAUDE__</string>
    <key>INBOX_TRIAGE_LOG</key>
    <string>__LOG__</string>
    <key>INBOX_TRIAGE_LANGUAGE</key>
    <string>__LANGUAGE__</string>
    <key>PATH</key>
    <string>__CLAUDE_DIR__:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>1</integer>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>2</integer>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>3</integer>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>4</integer>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key>
      <integer>5</integer>
      <key>Hour</key>
      <integer>10</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
